{
  "name": "threadmark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run release:check && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "security:check": "node scripts/check-secrets.mjs",
    "test:security": "node --import tsx --conditions=react-server --test tests/*.test.mjs",
    "test": "npm run test:security",
    "test:e2e": "playwright test",
    "release:check": "node --import tsx --conditions=react-server scripts/check-release.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "firebase": "^13.1.0",
    "jose": "^6.2.13",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
