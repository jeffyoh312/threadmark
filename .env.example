# Configure these in Vercel Project Settings > Environment Variables.
# This template contains no credentials. .env.local is optional for contributors.
ANALYSIS_ENABLED=false
RELEASE_READY=false
APP_ORIGIN=
PUBLIC_OPERATOR_NAME=Khaled Morshed
PUBLIC_CONTACT_EMAIL=

# Private server credentials. Never use NEXT_PUBLIC_ for these values.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_DATA_MODE=unpaid
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=

# Public browser configuration for a separate Firebase Authentication project.
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Comma-separated verified emails; empty allows all eligible Google users.
ALLOWED_EMAILS=
# Explicit country allowlist. Default launch region: Malaysia.
ALLOWED_COUNTRIES=MY
USER_ANALYSES_PER_MINUTE=2
USER_ANALYSES_PER_DAY=5
SITE_ANALYSES_PER_DAY=20
QUOTA_NAMESPACE=threadmark:production:v1
