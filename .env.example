# Configure these in Vercel Project Settings > Environment Variables.
# This template contains no credentials. .env.local is optional for contributors.
ANALYSIS_ENABLED=false
RELEASE_READY=false
APP_ORIGIN=
PUBLIC_OPERATOR_NAME=Khaled Morshed
PUBLIC_CONTACT_EMAIL=

# Private server credentials. Never use NEXT_PUBLIC_ for these values.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_DATA_MODE=unpaid
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=

# Public browser configuration. Only this Turnstile site key belongs in the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this stable across deployments; rotating resets visitor buckets.
RATE_LIMIT_SECRET=
# Empty permits all regions except restrictions for Gemini unpaid processing.
# Use paid mode only when the Google project really has paid-service terms.
ALLOWED_COUNTRIES=
VISITOR_ANALYSES_PER_MINUTE=2
VISITOR_ANALYSES_PER_DAY=5
SITE_ANALYSES_PER_DAY=20
QUOTA_NAMESPACE=threadmark:production:v1
SITE_CONCURRENT_ANALYSES=3
