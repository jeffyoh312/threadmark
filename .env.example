# Copy to .env.local for local development. Everything is optional locally:
# without keys the example still works, and limits/bot checks are skipped.
# In production (Vercel) the first four are required.

# Google AI Studio key (free tier is fine): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Upstash Redis REST credentials (free tier): https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (free): https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Any long random string. Used to anonymise IP addresses before they reach Redis.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=

# Optional
# GEMINI_MODEL=          Try this model before the built-in Flash-Lite defaults
# GEMINI_PAID=true       Your Gemini project is on paid terms (lifts the EEA/UK block)
# ANALYSIS_ENABLED=false Pause live analysis without redeploying code
